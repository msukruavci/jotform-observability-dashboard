DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production defaults enable HTTPS redirect, secure cookies, and one-year HSTS when DJANGO_DEBUG=0.
# Set this only behind a trusted reverse proxy that overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=0
DATABASE_URL=postgresql://observability:observability@db:5432/observability
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
MCP_LOG_ROOT=/data/mcp
INGEST_INTERVAL_SECONDS=300
