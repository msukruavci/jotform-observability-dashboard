#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"
ENV_FILE="$SCRIPT_DIR/.env"
ENV_EXAMPLE="$SCRIPT_DIR/.env.example"

usage() {
  printf '%s\n' \
    "Kullanım: dashboard <komut>" \
    "" \
    "  up       Dashboard'ı build edip arka planda başlat" \
    "  down     Dashboard'ı durdur; veritabanını koru" \
    "  restart  Servisleri yeniden başlat" \
    "  status   Servis durumlarını göster" \
    "  logs     Canlı servis loglarını göster (Ctrl+C ile çık)" \
    "  open     Dashboard adresini yazdır"
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    printf 'Hata: Docker kurulu değil veya PATH içinde bulunamadı.\n' >&2
    exit 1
  fi
  if ! docker compose version >/dev/null 2>&1; then
    printf 'Hata: Docker Compose plugin bulunamadı.\n' >&2
    exit 1
  fi
}

ensure_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    printf 'Yerel ayarlar oluşturuldu: %s\n' "$ENV_FILE"
  fi
}

compose() {
  docker compose --project-directory "$SCRIPT_DIR" --file "$COMPOSE_FILE" "$@"
}

command_name="${1:-}"
case "$command_name" in
  up)
    require_docker
    ensure_env
    printf 'Pulseboard başlatılıyor…\n'
    compose up --detach --build --wait
    printf '\nHazır: http://localhost:8090\n'
    ;;
  down)
    require_docker
    compose down
    printf 'Pulseboard durduruldu. PostgreSQL ve Redis verileri korundu.\n'
    ;;
  restart)
    require_docker
    ensure_env
    compose restart
    printf 'Pulseboard yeniden başlatıldı: http://localhost:8090\n'
    ;;
  status)
    require_docker
    compose ps
    ;;
  logs)
    require_docker
    compose logs --follow --tail=150 web worker beat
    ;;
  open)
    printf 'http://localhost:8090\n'
    ;;
  help|-h|--help|"")
    usage
    ;;
  *)
    printf 'Bilinmeyen komut: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac

